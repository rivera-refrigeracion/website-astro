---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { imagenLocal } from '@/lib/images';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Blog"
  description="Artículos y consejos sobre aire acondicionado, neveras, lavadoras y calentadores. Aprende a cuidar tus electrodomésticos con Rivera Refrigeración."
  pageType="CollectionPage"
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Blog', path: '/blog/' },
  ]}
>
  <section class="section bg-neutral-50">
    <div class="container">
      <h1 class="text-3xl lg:text-4xl font-bold text-center mb-12">Blog</h1>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          posts.map((post, indice) => (
            <article class="card hover:shadow-[var(--shadow-level2)] transition-shadow group">
              {post.data.image && (
                <a
                  href={`/blog/${post.slug}/`}
                  class="block aspect-video overflow-hidden rounded-md mb-4"
                >
                  <Picture
                    src={imagenLocal(post.data.image.url)}
                    formats={['avif']}
                    fallbackFormat="webp"
                    alt={post.data.image.alt}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    widths={[400, 704]}
                    sizes="(min-width: 1024px) 336px, (min-width: 768px) calc(50vw - 88px), calc(100vw - 96px)"
                    loading={indice === 0 ? 'eager' : 'lazy'}
                    fetchpriority={indice === 0 ? 'high' : 'auto'}
                  />
                </a>
              )}

              <span class="inline-block text-sm text-primary-600 font-medium mb-2">
                {post.data.category}
              </span>

              <h2 class="text-xl font-semibold mb-3 text-neutral-900 group-hover:text-primary-600 transition-colors">
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
              </h2>

              <div class="text-sm text-neutral-500 mb-3">
                <span>{post.data.category}</span>
                <span class="mx-1">/</span>
                <span>{post.data.author}</span>
              </div>

              <p class="text-neutral-600 line-clamp-3">
                {post.data.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
