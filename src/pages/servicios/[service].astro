---
import { getImage, Picture } from 'astro:assets';
import { type CollectionEntry, getCollection } from 'astro:content';
import Turbine from '@/components/ui/Turbine.astro';
import Wave from '@/components/ui/Wave.astro';
import Layout from '@/layouts/Layout.astro';
import { CONTACT } from '@/lib/config';
import { imagenLocal } from '@/lib/images';
import {
  idServicio,
  idOferta,
  OFERTAS_CATALOGO,
  preguntas,
  ref,
  servicio as servicioSchema,
  urlAbsoluta,
} from '@/lib/schema';
import { whatsappUrl } from '@/lib/utils';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { service: service.slug },
    props: service,
  }));
}

type Props = CollectionEntry<'services'>;

const service: Props = Astro.props;
const { Content } = await service.render();
const articulosRelacionados = (await getCollection('blog'))
  .filter(
    (post) => !post.data.draft && post.data.relatedService === service.slug
  )
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const url = urlAbsoluta(`/servicios/${service.slug}/`);
// Nunca más ancha que el archivo: una foto de 500 px estirada a 896 se ve
// borrosa (Lighthouse, image-size-responsive).
const imagenPrincipal = imagenLocal(service.data.heroImage.url);

// El schema necesita una URL que exista: el original ya no se publica en
// /images/, sólo las versiones que genera Astro.
const imagenSchema = await getImage({
  src: imagenPrincipal,
  format: 'jpg',
  width: Math.min(1200, imagenPrincipal.width),
});
const ofertaPrincipal = OFERTAS_CATALOGO.find(
  (oferta) => oferta.slug === service.slug && oferta.fragmento === 'servicio'
);
if (!ofertaPrincipal) {
  throw new Error(`No hay una oferta principal de schema para ${service.slug}`);
}
---

<Layout
  title={service.data.metaTitle}
  description={service.data.metaDescription}
  image={service.data.ogImage.url}
  imageAlt={service.data.ogImage.alt}
  imageWidth={1200}
  imageHeight={630}
  pageType="FAQPage"
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: service.data.h1, path: `/servicios/${service.slug}/` },
  ]}
  pageSchema={{
    about: ref(idServicio(url)),
    mainEntity: preguntas(service.data.faqs),
  }}
  schemaNodes={[
    servicioSchema({
      id: idOferta(ofertaPrincipal),
      url,
      nombre: ofertaPrincipal.nombre,
      tipo: ofertaPrincipal.tipo,
      descripcion: service.data.metaDescription,
      imagen: urlAbsoluta(imagenSchema.src),
      zonas: service.data.serviceAreas,
    }),
  ]}
>
  <article class="pb-16 lg:pb-24">
    <!-- Hero Section -->
    <header class="servicio-cabecera on-dark relative isolate overflow-hidden">
      <div class="absolute inset-0 -z-10" aria-hidden="true">
        <div class="servicio-brillo respirar"></div>
        <Turbine
          class="servicio-turbina girar text-primary-300"
          tone="var(--color-primary-600)"
        />
      </div>
      <div
        class="container max-w-4xl mx-auto text-center pt-14 pb-40 lg:pt-20 lg:pb-56"
      >
        <h1
          class="text-3xl lg:text-5xl font-bold mb-5 text-white leading-tight text-balance"
        >
          {service.data.h1}
        </h1>
        <p class="text-lg lg:text-xl text-primary-50/90 leading-relaxed">
          {service.data.shortDescription}
        </p>
      </div>
      <Wave />
    </header>

    <div class="container">
      <!-- Hero Image -->
      <figure
        class="servicio-foto relative z-10 max-w-4xl mx-auto -mt-32 lg:-mt-44 mb-16"
      >
        <Picture
          src={imagenPrincipal}
          formats={['avif']}
          fallbackFormat="webp"
          alt={service.data.heroImage.alt}
          class="w-full h-auto mx-auto rounded-[var(--radius-xl)]"
          style={`max-width: ${imagenPrincipal.width}px`}
          widths={[400, 600, 800, 896, 1200]}
          sizes="(min-width: 944px) 896px, calc(100vw - 48px)"
          loading="eager"
          fetchpriority="high"
        />
      </figure>

      <!-- Main Content -->
      <div class="max-w-4xl mx-auto">
        <!-- Service Overview & Problems (Markdown Content) -->
        <div class="prose prose-lg max-w-none mb-16">
          <Content />
        </div>

        {
          articulosRelacionados.length > 0 && (
            <section class="mb-20" aria-labelledby="guias-relacionadas">
              <h2
                id="guias-relacionadas"
                class="title-accent text-2xl lg:text-3xl font-bold mb-8 text-center"
                data-reveal
              >
                Guías relacionadas
              </h2>
              <ul class="flex flex-wrap justify-center gap-4">
                {articulosRelacionados.map((articulo, i) => (
                  <li
                    class="w-full md:w-[calc(50%-0.5rem)]"
                    data-reveal
                    style={`--reveal-i: ${i}`}
                  >
                    <a
                      href={`/blog/${articulo.slug}/`}
                      class="guia card group flex h-full flex-col gap-2 text-neutral-900 hover:text-neutral-900"
                    >
                      <span class="font-semibold text-lg leading-snug text-primary-800">
                        {articulo.data.title}
                      </span>
                      <span class="text-neutral-600 text-sm leading-relaxed flex-grow">
                        {articulo.data.description}
                      </span>
                      <span class="inline-flex items-center gap-1.5 text-secondary-950 font-semibold text-sm mt-2">
                        Leer la guía
                        <svg
                          class="guia-flecha w-4 h-4"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M5 12h14m-6-6 6 6-6 6"
                          />
                        </svg>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <!-- Brands Section -->
        {
          service.data.brands.length > 0 && (
            <section class="mb-20" data-reveal>
              <h2 class="title-accent text-2xl lg:text-3xl font-bold mb-8 text-center">
                Marcas atendidas
              </h2>
              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 items-center">
                {service.data.brands.map((brand) => (
                  <div class="marca-ficha">
                    {brand.logo ? (
                      <img
                        src={brand.logo}
                        alt={`Logo ${brand.name}`}
                        class="h-12 mx-auto object-contain"
                        loading="lazy"
                      />
                    ) : (
                      <p class="font-semibold text-neutral-700">{brand.name}</p>
                    )}
                  </div>
                ))}
              </div>
            </section>
          )
        }

        <!-- Process Section -->
        <section class="proceso mb-20 rounded-[var(--radius-xl)] p-6 sm:p-10">
          <h2
            class="title-accent text-2xl lg:text-3xl font-bold mb-10 text-center"
            data-reveal
          >
            Nuestro Proceso de Trabajo
          </h2>
          <div
            class="proceso-pasos relative grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5"
          >
            {
              service.data.process.map((step, i) => (
                <div
                  class="paso relative text-center"
                  data-reveal
                  style={`--reveal-i: ${i}`}
                >
                  <div class="paso-icono text-3xl mb-4" aria-hidden="true">
                    {step.icon}
                  </div>
                  <div class="text-xs uppercase tracking-[0.12em] font-bold text-primary-800 mb-2">
                    Paso {step.step}
                  </div>
                  <h3 class="font-bold text-lg mb-2">{step.title}</h3>
                  <p class="text-neutral-600 text-sm">{step.description}</p>
                </div>
              ))
            }
          </div>
        </section>

        <!-- Service Areas -->
        <section class="mb-20" data-reveal>
          <h2
            class="title-accent text-2xl lg:text-3xl font-bold mb-6 text-center"
          >
            Zonas donde atendemos
          </h2>
          <p class="text-neutral-600 text-center mb-6">
            Servicio a domicilio en Cali y alrededores.
          </p>
          <ul class="flex flex-wrap justify-center gap-3">
            {
              service.data.serviceAreas.map((zona) => (
                <li class="zona inline-flex items-center gap-2 bg-primary-50 text-primary-800 rounded-full px-4 py-2 text-sm font-medium">
                  {zona}
                </li>
              ))
            }
          </ul>
        </section>

        <!-- FAQ Section -->
        <section class="mb-20">
          <h2
            class="title-accent text-2xl lg:text-3xl font-bold mb-10 text-center"
            data-reveal
          >
            Preguntas Frecuentes
          </h2>
          <div class="space-y-3" data-reveal>
            {
              service.data.faqs.map((faq) => (
                <details class="faq group bg-white rounded-2xl border border-neutral-200 overflow-hidden">
                  <summary class="cursor-pointer px-5 py-4 sm:px-6 sm:py-5 font-semibold text-lg list-none flex items-center justify-between gap-4">
                    <span>{faq.question}</span>
                    <svg
                      class="faq-chevron shrink-0 w-8 h-8 p-1.5 rounded-full bg-primary-50 text-primary-800 group-open:rotate-180"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"
                      />
                    </svg>
                  </summary>
                  <div class="faq-respuesta px-5 pb-5 sm:px-6 sm:pb-6 text-neutral-700 leading-relaxed">
                    {faq.answer}
                  </div>
                </details>
              ))
            }
          </div>
        </section>

        <!-- CTA Section -->
        <section
          class="servicio-cierre on-dark relative isolate overflow-hidden text-center text-white rounded-[var(--radius-xl)] px-6 py-12 sm:p-14"
          data-reveal="zoom"
        >
          <Turbine
            class="servicio-cierre-turbina girar-inverso text-primary-300"
            tone="var(--color-primary-600)"
          />
          <h2 class="text-2xl lg:text-3xl font-bold mb-4">
            ¿Necesita este servicio?
          </h2>
          <p class="text-lg mb-8 text-primary-50/90 max-w-xl mx-auto">
            Rivera Refrigeración revisa el equipo y presenta el presupuesto
            antes de empezar. Agende su visita por WhatsApp.
          </p>
          <a
            href={whatsappUrl(
              `desde la página de ${service.data.title.toLowerCase()}`
            )}
            target="_blank"
            rel="noopener noreferrer"
            class="whatsapp-btn whatsapp-cta-service inline-flex items-center gap-2 text-white px-8 py-4 font-semibold text-lg"
            data-service={service.slug}
            data-ubicacion="servicio_cierre"
            aria-label="Agendar visita por WhatsApp"
          >
            <svg
              class="w-6 h-6"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
              ></path>
            </svg>
            Agendar visita por WhatsApp
          </a>
          <p class="text-sm mt-6 text-primary-100">
            Llamadas: <a
              href={`tel:${CONTACT.phone}`}
              class="phone-link phone-link-service text-white underline hover:no-underline"
              data-service={service.slug}
              data-ubicacion="servicio_cierre">{CONTACT.phone}</a
            >
          </p>
        </section>
      </div>
    </div>
  </article>
</Layout>

<style>
  .servicio-cabecera {
    background: linear-gradient(
      165deg,
      var(--color-primary-950) 0%,
      #0a2e6b 50%,
      var(--color-primary-900) 100%
    );
  }

  .servicio-brillo {
    position: absolute;
    width: 64rem;
    height: 36rem;
    top: -22rem;
    left: 50%;
    margin-left: -32rem;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(255 122 26 / 0.3),
      rgb(255 122 26 / 0)
    );
  }

  :global(.servicio-turbina) {
    position: absolute;
    width: 36rem;
    height: 36rem;
    top: -10rem;
    right: -14rem;
    opacity: 0.08;
    --giro: 90s;
  }

  .servicio-foto :global(img) {
    box-shadow: var(--shadow-level3);
  }

  .marca-ficha {
    display: grid;
    place-items: center;
    min-height: 4.5rem;
    padding: 1rem;
    text-align: center;
    border-radius: 1rem;
    background: white;
    border: 1px solid rgb(7 31 71 / 0.08);
    box-shadow: var(--shadow-level1);
    transition:
      box-shadow 0.35s var(--ease-out),
      transform 0.35s var(--ease-out);
  }

  .marca-ficha:hover {
    box-shadow: var(--shadow-level2);
  }

  .guia:hover {
    box-shadow: var(--shadow-level2);
  }

  .guia-flecha {
    transition: translate 0.35s var(--ease-out);
  }

  .proceso {
    background:
      radial-gradient(
        30rem 16rem at 100% 0%,
        rgb(255 152 0 / 0.1),
        transparent 70%
      ),
      var(--color-primary-50);
  }

  /* El hilo que une los pasos en escritorio, detrás de las tarjetas. */
  @media (min-width: 1024px) {
    .proceso-pasos::before {
      content: '';
      position: absolute;
      top: 3.25rem;
      left: 12%;
      right: 12%;
      height: 2px;
      background: linear-gradient(
        90deg,
        var(--color-primary-400),
        var(--color-primary-200)
      );
    }
  }

  .paso {
    padding: 1.5rem 1.25rem;
    border-radius: 1.25rem;
    background: white;
    box-shadow: var(--shadow-level1);
    transition:
      box-shadow 0.35s var(--ease-out),
      transform 0.35s var(--ease-out);
  }

  .paso:hover {
    box-shadow: var(--shadow-level2);
  }

  .paso-icono {
    display: inline-grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: linear-gradient(
      145deg,
      var(--color-secondary-50),
      var(--color-secondary-100)
    );
    box-shadow:
      0 0 0 6px white,
      inset 0 0 0 1px rgb(255 152 0 / 0.2);
  }

  .zona::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-secondary-500);
  }

  .faq {
    transition:
      box-shadow 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out);
  }

  .faq:hover,
  .faq[open] {
    border-color: var(--color-primary-200);
    box-shadow: var(--shadow-level2);
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    transition: rotate 0.4s var(--ease-out);
  }

  .servicio-cierre {
    background: linear-gradient(
      150deg,
      var(--color-primary-800),
      var(--color-primary-950) 75%
    );
    box-shadow: var(--shadow-level3);
  }

  :global(.servicio-cierre-turbina) {
    position: absolute;
    z-index: -1;
    width: 26rem;
    height: 26rem;
    right: -8rem;
    bottom: -10rem;
    opacity: 0.1;
    --giro: 90s;
  }

  @media (prefers-reduced-motion: no-preference) {
    .marca-ficha:hover,
    .paso:hover,
    .guia:hover {
      transform: translateY(-4px);
    }

    .guia:hover .guia-flecha {
      translate: 4px 0;
    }

    .faq[open] .faq-respuesta {
      animation: subir 0.45s var(--ease-out) backwards;
    }
  }
</style>
