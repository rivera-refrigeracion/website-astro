---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { CONTACT } from '@/lib/config';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { service: service.slug },
    props: service,
  }));
}

type Props = CollectionEntry<'services'>;

const service = Astro.props;
const { Content } = await service.render();
---

<Layout
  title={service.data.metaTitle}
  description={service.data.metaDescription}
  image={service.data.heroImage.url}
>
  <article class="py-12">
    <div class="container">
      <!-- Hero Section -->
      <header class="max-w-4xl mx-auto text-center mb-12">
        <h1 class="text-3xl lg:text-5xl font-bold mb-4 text-neutral-900">
          {service.data.title}
        </h1>
        <p class="text-lg lg:text-xl text-neutral-600">
          {service.data.shortDescription}
        </p>
      </header>

      <!-- Hero Image -->
      <figure class="max-w-4xl mx-auto mb-12">
        <img
          src={service.data.heroImage.url}
          alt={service.data.heroImage.alt}
          class="w-full h-auto rounded-lg shadow-lg"
          loading="eager"
          width="1200"
          height="600"
        />
      </figure>

      <!-- Main Content -->
      <div class="max-w-4xl mx-auto">
        <!-- Service Overview & Problems (Markdown Content) -->
        <div class="prose prose-lg max-w-none mb-16">
          <Content />
        </div>

        <!-- Brands Section -->
        <section class="mb-16">
          <h2 class="text-2xl lg:text-3xl font-bold mb-6 text-center">
            Marcas que Atendemos
          </h2>
          <div
            class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6 items-center"
          >
            {
              service.data.brands.map((brand) => (
                <div class="text-center p-4 bg-neutral-50 rounded-lg">
                  {brand.logo ? (
                    <img
                      src={brand.logo}
                      alt={`Logo ${brand.name}`}
                      class="h-12 mx-auto object-contain"
                      loading="lazy"
                    />
                  ) : (
                    <p class="font-semibold text-neutral-700">{brand.name}</p>
                  )}
                </div>
              ))
            }
            <div class="text-center p-4 bg-neutral-50 rounded-lg">
              <p class="font-semibold text-neutral-700">Y más...</p>
            </div>
          </div>
        </section>

        <!-- Process Section -->
        <section class="mb-16 bg-primary-50 rounded-lg p-8">
          <h2 class="text-2xl lg:text-3xl font-bold mb-8 text-center">
            Nuestro Proceso de Trabajo
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {
              service.data.process.map((step) => (
                <div class="text-center">
                  <div class="text-4xl mb-3">{step.icon}</div>
                  <div class="text-sm font-semibold text-primary-600 mb-2">
                    Paso {step.step}
                  </div>
                  <h3 class="font-bold text-lg mb-2">{step.title}</h3>
                  <p class="text-neutral-600 text-sm">{step.description}</p>
                </div>
              ))
            }
          </div>
        </section>

        <!-- FAQ Section -->
        <section class="mb-16">
          <h2 class="text-2xl lg:text-3xl font-bold mb-8 text-center">
            Preguntas Frecuentes
          </h2>
          <div class="space-y-4">
            {
              service.data.faqs.map((faq) => (
                <details class="group bg-white rounded-lg shadow-sm border border-neutral-200 overflow-hidden">
                  <summary class="cursor-pointer p-4 font-semibold text-lg hover:bg-neutral-50 transition-colors list-none flex items-center justify-between">
                    <span>{faq.question}</span>
                    <svg
                      class="w-5 h-5 text-neutral-500 transition-transform group-open:rotate-180"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"
                      />
                    </svg>
                  </summary>
                  <div class="p-4 pt-0 text-neutral-700">{faq.answer}</div>
                </details>
              ))
            }
          </div>
        </section>

        <!-- Pricing Section -->
        <section class="mb-16 bg-secondary-50 rounded-lg p-8">
          <h2 class="text-2xl lg:text-3xl font-bold mb-6 text-center">
            Tarifas
          </h2>
          <div class="max-w-2xl mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
              <div class="text-center p-4 bg-white rounded-lg">
                <p class="text-sm text-neutral-600 mb-2">
                  Visita de Diagnóstico
                </p>
                <p class="text-2xl font-bold text-secondary-600">
                  {service.data.pricing.inspection}
                </p>
              </div>
              {
                service.data.pricing.hourlyRate && (
                  <div class="text-center p-4 bg-white rounded-lg">
                    <p class="text-sm text-neutral-600 mb-2">Mano de Obra</p>
                    <p class="text-2xl font-bold text-secondary-600">
                      {service.data.pricing.hourlyRate}
                    </p>
                  </div>
                )
              }
            </div>
            {
              service.data.pricing.notes && (
                <p class="text-sm text-neutral-600 text-center italic">
                  {service.data.pricing.notes}
                </p>
              )
            }
          </div>
        </section>

        <!-- CTA Section -->
        <section class="text-center bg-primary-600 text-white rounded-lg p-8">
          <h2 class="text-2xl lg:text-3xl font-bold mb-4">
            ¿Necesitas este servicio?
          </h2>
          <p class="text-lg mb-6 opacity-90">
            Contáctanos ahora y recibe atención inmediata. Más de 30 años de
            experiencia nos respaldan.
          </p>
          <a
            href={CONTACT.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white px-8 py-4 rounded-lg font-semibold text-lg transition-colors shadow-lg"
          >
            <svg
              class="w-6 h-6"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
              ></path>
            </svg>
            Contáctanos por WhatsApp
          </a>
          <p class="text-sm mt-4 opacity-75">
            Llamadas: <a
              href={`tel:${CONTACT.phone}`}
              class="underline hover:no-underline">{CONTACT.phone}</a
            >
          </p>
        </section>
      </div>
    </div>
  </article>

  <!-- FAQ Schema Markup -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: service.data.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    })}
  />

  <!-- Service Schema Markup -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: service.data.title,
      description: service.data.metaDescription,
      provider: {
        '@type': 'LocalBusiness',
        name: 'Rivera Refrigeración',
        telephone: '+573173095159',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Cali',
          addressRegion: 'Valle del Cauca',
          addressCountry: 'CO',
        },
      },
      areaServed: {
        '@type': 'City',
        name: 'Cali',
      },
      offers: {
        '@type': 'Offer',
        priceSpecification: {
          '@type': 'PriceSpecification',
          priceCurrency: 'COP',
          price: service.data.pricing.inspection.match(/\d+/)?.[0] || '25000',
        },
      },
    })}
  />
</Layout>
