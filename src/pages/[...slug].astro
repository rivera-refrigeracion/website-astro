---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { CONTACT } from '@/lib/config';
import type { ISODateString } from '@/types';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await post.render();

const formattedDate = new Intl.DateTimeFormat('es-CO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(post.data.pubDate);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  article={true}
  publishedTime={post.data.pubDate.toISOString() as ISODateString}
  modifiedTime={post.data.updatedDate?.toISOString() as ISODateString}
  author={post.data.author}
  section={post.data.category}
  tags={post.data.tags}
  image={post.data.image?.url}
>
  <article class="py-12">
    <div class="container">
      <header class="max-w-3xl mx-auto text-center mb-8">
        <h1 class="text-3xl lg:text-4xl font-bold mb-4 text-neutral-900">
          {post.data.title}
        </h1>
        <div class="text-neutral-500 mb-4">
          <span>Por {post.data.author}</span>
          <span class="mx-2">/</span>
          <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time
          >
        </div>
        {
          post.data.tags && post.data.tags.length > 0 && (
            <div class="flex flex-wrap justify-center gap-2">
              {post.data.tags.map((tag: string) => (
                <span class="inline-block bg-primary-100 text-primary-700 text-sm px-3 py-1 rounded-full">
                  {tag}
                </span>
              ))}
            </div>
          )
        }
      </header>

      {
        post.data.image?.url && post.data.imagePosition === 'top' && (
          <figure class="max-w-3xl mx-auto mb-8">
            <img
              src={post.data.image.url}
              alt={post.data.image.alt || post.data.title}
              class="w-full h-auto rounded-lg shadow-lg"
              loading="eager"
            />
          </figure>
        )
      }

      <div class="max-w-3xl mx-auto">
        <div class="prose prose-lg">
          <Content />
        </div>

        <div class="mt-12 pt-8 border-t border-neutral-200">
          <div class="text-center">
            <p class="text-lg text-neutral-700 mb-4">
              ¿Necesitas ayuda con tus electrodomésticos?
            </p>
            <a
              href={CONTACT.whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="whatsapp-btn"
            >
              <svg
                class="w-5 h-5"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                ></path>
              </svg>
              Contáctanos por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>
</Layout>
