---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/sections/Hero.astro';
import Services from '@/components/sections/Services.astro';
import About from '@/components/sections/About.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import WhyUs from '@/components/sections/WhyUs.astro';
import CTA from '@/components/sections/CTA.astro';
---

<Layout
  title="Servicio técnico de aire y electrodomésticos en Cali"
  description="Rivera Refrigeración presta reparación de aire acondicionado, neveras y lavadoras e instalación de aire y calentadores en Cali. Más de treinta años de servicio."
  image="/images/og-home.jpg"
  imageAlt="Técnico revisa una unidad exterior de aire acondicionado junto a la identidad gráfica de Rivera Refrigeración"
  imageWidth={1200}
  imageHeight={630}
>
  <Hero />
  <Services />
  <About />
  <Testimonials />
  <WhyUs />
  <CTA />
</Layout>
