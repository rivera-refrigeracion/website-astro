---
import { ADDRESS, CONTACT, HOURS, SERVICES, SITE, SOCIAL } from '@/lib/config';
import Turbine from '@/components/ui/Turbine.astro';
import { formatPhoneNumber, whatsappUrl } from '@/lib/utils';

const currentYear = new Date().getFullYear();

// Sin microdata a propósito: el negocio se describe una sola vez, en el
// JSON-LD del <head> (src/lib/schema.ts). Dos fuentes eran dos LocalBusiness
// distintos para Google, y el itemprop="email" en el <a> tomaba el href
// "mailto:" como valor.
---

<footer
  class="pie on-dark relative isolate overflow-hidden text-white pt-16 pb-10 lg:pt-20"
>
  <Turbine
    class="pie-turbina girar text-primary-300"
    tone="var(--color-primary-700)"
  />
  <div class="container">
    <!-- Main Footer Grid -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1.2fr_1fr] gap-10 mb-12"
    >
      <!-- Company Info -->
      <div>
        <h2 class="pie-titulo text-lg font-bold mb-5">{SITE.name}</h2>
        <p class="text-white/80 mb-4">
          Más de 30 años de experiencia en reparación y mantenimiento de
          electrodomésticos.
        </p>
        <p class="text-white/80">{ADDRESS.locality}, {ADDRESS.region}</p>
      </div>

      <!-- Services -->
      <div>
        <h2 class="pie-titulo text-lg font-bold mb-5">Servicios</h2>
        <nav aria-label="Enlaces a servicios">
          <ul class="space-y-2">
            {
              SERVICES.map((service) => (
                <li>
                  <a
                    href={`/servicios/${service.id}/`}
                    class="pie-enlace text-white/80 hover:text-white"
                  >
                    {service.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <!-- Contact -->
      <div>
        <h2 class="pie-titulo text-lg font-bold mb-5">Contacto</h2>
        <ul class="space-y-3">
          <li>
            <strong class="block text-sm text-primary-200">Llamadas:</strong>
            <a
              href={`tel:${CONTACT.phone}`}
              class="pie-enlace text-white/80 hover:text-white inline-flex items-center gap-2"
            >
              <svg
                class="w-4 h-4 shrink-0 text-secondary-300"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path></svg
              >
              {formatPhoneNumber(CONTACT.phone)}
            </a>
          </li>
          <li>
            <strong class="block text-sm text-primary-200"
              >WhatsApp (Agendamiento):</strong
            >
            <a
              href={whatsappUrl('desde el pie de página')}
              target="_blank"
              rel="noopener noreferrer"
              class="pie-enlace text-white/80 hover:text-white inline-flex items-center gap-2"
            >
              <svg
                class="w-4 h-4 shrink-0 text-secondary-300"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                ></path></svg
              >
              {formatPhoneNumber(CONTACT.whatsapp)}
            </a>
          </li>
          <li>
            <strong class="block text-sm text-primary-200">Email:</strong>
            <a
              href={`mailto:${CONTACT.email}`}
              class="pie-enlace text-white/80 hover:text-white inline-flex items-center gap-2"
            >
              <svg
                class="w-4 h-4 shrink-0 text-secondary-300"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path></svg
              >
              {CONTACT.email}
            </a>
          </li>
        </ul>
      </div>

      <!-- Hours -->
      <div>
        <h2 class="pie-titulo text-lg font-bold mb-5">Horario</h2>
        <div class="text-white/80 leading-relaxed">
          <p class="inline-flex items-center gap-2">
            <svg
              class="w-4 h-4 shrink-0 text-secondary-300"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
            >
            {HOURS.days}
          </p>
          <p class="ml-6">{HOURS.time}</p>
        </div>
      </div>
    </div>

    <!-- Bottom Section -->
    <div
      class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4"
    >
      <!-- Social Media -->
      <div class="flex items-center gap-4">
        <span class="text-primary-200 text-sm">Síguenos:</span>
        <a
          href={SOCIAL.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="pie-social"
          title="Síguenos en Facebook"
        >
          <svg
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"
            ></path>
          </svg>
        </a>
        <a
          href={SOCIAL.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="pie-social"
          title="Síguenos en Instagram"
        >
          <svg
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"
            ></path>
          </svg>
        </a>
        <a
          href={SOCIAL.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
          class="pie-social"
          title="Contáctanos por WhatsApp"
        >
          <svg
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
            ></path>
          </svg>
        </a>
      </div>

      <!-- Copyright -->
      <p class="text-primary-200 text-sm text-center">
        Copyright &copy; {currentYear}
        {SITE.name}. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>

<style>
  .pie {
    background:
      radial-gradient(
        50rem 20rem at 85% 0%,
        rgb(255 122 26 / 0.12),
        transparent 70%
      ),
      var(--color-primary-950);
  }

  /* Franja fría en el borde superior, igual que en el encabezado. */
  .pie::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--color-primary-500),
      var(--color-primary-300),
      var(--color-primary-100)
    );
  }

  :global(.pie-turbina) {
    position: absolute;
    z-index: -1;
    width: 28rem;
    height: 28rem;
    right: -9rem;
    bottom: -9rem;
    opacity: 0.06;
    --giro: 140s;
  }

  .pie-titulo {
    font-family: var(--font-heading);
    letter-spacing: 0.01em;
  }

  .pie-enlace {
    position: relative;
    transition: color var(--transition-fast);
  }

  .pie-enlace::after {
    content: '';
    position: absolute;
    inset: auto 0 -2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }

  .pie-enlace:hover::after {
    transform: scaleX(1);
  }

  .pie-social {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    color: rgb(255 255 255 / 0.85);
    background: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast),
      transform 0.3s var(--ease-out);
  }

  .pie-social:hover {
    color: var(--color-primary-950);
    background: var(--color-secondary-400);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pie-social:hover {
      transform: translateY(-3px);
    }
  }
</style>
