---
/**
 * Chatwoot live chat widget
 * Loads the Chatwoot SDK for customer support chat
 * Hidden initially on mobile, shows on scroll
 */
---

<script is:inline>
  (function () {
    var isMobile = window.innerWidth < 768;

    window.chatwootSettings = {
      position: 'right',
      type: 'standard',
      launcherTitle: 'Habla con nosotros',
      hideMessageBubble: isMobile,
    };

    var BASE_URL = 'https://chatwoot.jjuanrivvera.com';
    var g = document.createElement('script'),
      s = document.getElementsByTagName('script')[0];
    g.src = BASE_URL + '/packs/js/sdk.js';
    g.defer = true;
    g.async = true;
    s.parentNode.insertBefore(g, s);
    g.onload = function () {
      window.chatwootSDK.run({
        websiteToken: 'D5NFtGXHnQFwJh4Z9BUY7jeX',
        baseUrl: BASE_URL,
      });

      // Show widget on scroll only for mobile (after 300px)
      if (isMobile) {
        var hasShown = false;
        var scrollThreshold = 300;

        function showChatwootOnScroll() {
          if (hasShown) return;

          if (window.scrollY > scrollThreshold) {
            hasShown = true;
            if (window.$chatwoot) {
              window.$chatwoot.toggle('open');
              setTimeout(function () {
                window.$chatwoot.toggle('close');
              }, 100);
            }
            window.removeEventListener('scroll', showChatwootOnScroll);
          }
        }

        window.addEventListener('scroll', showChatwootOnScroll, {
          passive: true,
        });
      }
    };
  })();
</script>
