---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { Thing } from 'schema-dts';
import logoMarca from '@/assets/images/logo.webp';
import { ADDRESS, GEO, SERVICES, SITE } from '@/lib/config';
import {
  NEGOCIO_ID,
  articulo,
  grafo,
  idArticulo,
  migas,
  negocio,
  pagina,
  ref,
  sitio,
} from '@/lib/schema';
import type { SEOProps } from '@/types';

interface Props extends SEOProps {}

/** Generada por scripts/generar-og.mjs: JPEG de 1200x630. */
const OG_POR_DEFECTO = '/images/og-default.jpg';

const {
  title,
  description = SITE.description,
  image = OG_POR_DEFECTO,
  imageAlt,
  imageWidth,
  imageHeight,
  article = false,
  publishedTime,
  modifiedTime,
  author = SITE.author,
  section,
  tags = [],
  noindex = false,
  pageType,
  breadcrumbs = [],
  pageSchema,
  schemaNodes = [],
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonicalURL = new URL(Astro.url.pathname, SITE.url);
const imageURL = new URL(image, SITE.url);

// Sólo se anuncian las dimensiones cuando se conocen de verdad. Declarar
// 1200x630 para una imagen que no lo es empeora el recorte en algunas
// plataformas (auditoría 2026-09-22, B4).
const esOgPorDefecto = image === OG_POR_DEFECTO;
const anchoOg = imageWidth ?? (esOgPorDefecto ? 1200 : undefined);
const altoOg = imageHeight ?? (esOgPorDefecto ? 630 : undefined);

// Un solo @graph por página, con el negocio completo en todas: Google sólo
// resuelve los @id dentro del mismo documento.
const servicios = (await getCollection('services'))
  .map((s) => ({
    slug: s.slug,
    title: s.data.title,
    serviceAreas: s.data.serviceAreas,
  }))
  .sort(
    (a, b) =>
      SERVICES.findIndex((s) => s.id === a.slug) -
      SERVICES.findIndex((s) => s.id === b.slug)
  );
// Google pide un logo de al menos 112 px en un formato que indexe; PNG es el
// más seguro.
const logo = await getImage({ src: logoMarca, format: 'png', width: 512 });
const url = canonicalURL.toString();
const nodos: Thing[] = [
  negocio(servicios, new URL(logo.src, SITE.url).toString()),
  sitio(),
  pagina({
    url,
    tipo: pageType,
    nombre: pageTitle,
    descripcion: description,
    imagen: imageURL.toString(),
    conMigas: breadcrumbs.length > 0,
    extra: {
      ...(article && { mainEntity: ref(idArticulo(url)) }),
      ...(Astro.url.pathname === '/' && { about: ref(NEGOCIO_ID) }),
      ...pageSchema,
    },
  }),
  ...(breadcrumbs.length > 0 ? [migas(url, breadcrumbs)] : []),
  ...(article && publishedTime
    ? [
        articulo({
          url,
          titulo: title ?? pageTitle,
          descripcion: description,
          imagen: imageURL.toString(),
          // Sólo la fecha: el contenido guarda días, no horas, y
          // "T00:00:00Z" sería la tarde anterior en Cali.
          publicado: publishedTime.slice(0, 10),
          modificado: modifiedTime?.slice(0, 10),
          autor: author,
          seccion: section,
          etiquetas: tags,
        }),
      ]
    : []),
  ...schemaNodes,
];
// Una página noindex (la 404) no describe ninguna entidad. Al serializar se
// escapa "<" para que un texto con "</script>" no cierre el bloque.
const jsonLd = noindex ? undefined : grafo(nodos);
---

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />
<meta name="author" content={author} />
<link rel="canonical" href={canonicalURL} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Language -->
<meta property="og:locale" content={SITE.locale} />
<link rel="alternate" hreflang="es" href={canonicalURL} />
<link rel="alternate" hreflang="x-default" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
{anchoOg && <meta property="og:image:width" content={String(anchoOg)} />}
{altoOg && <meta property="og:image:height" content={String(altoOg)} />}
<meta property="og:image:alt" content={imageAlt ?? pageTitle} />
<meta property="og:site_name" content={SITE.name} />

{
  article && (
    <>
      <meta property="article:published_time" content={publishedTime} />
      {modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )}
      <meta property="article:author" content={author} />
      {section && <meta property="article:section" content={section} />}
      {tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<!-- Additional SEO Meta Tags -->
<meta name="geo.region" content={ADDRESS.regionCode} />
<meta name="geo.placename" content={ADDRESS.locality} />
<meta name="geo.position" content={`${GEO.latitude};${GEO.longitude}`} />
<meta name="ICBM" content={`${GEO.latitude}, ${GEO.longitude}`} />

<!-- Structured Data -->
{
  jsonLd && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
    />
  )
}
