---
// Google Tag Manager - Head Script
// Manages all analytics and conversion tracking through GTM container
// Only included in production builds, and at runtime only runs on the
// production hosts (see HOSTS_PRODUCCION in src/lib/medicion.ts)
// Note: This component only includes the <head> script portion
// The <noscript> iframe fallback should be added in <body> via AnalyticsBody.astro
// La carga es diferida; el porqué está en src/lib/gtm-diferido.js.
import { scriptMedicion } from '@/lib/medicion';

const isProduction = import.meta.env.PROD;
const script = scriptMedicion();
---

{isProduction && <script is:inline set:html={script} />}
