---
import { Picture } from 'astro:assets';
import electrodomesticos from '@/assets/images/hero-appliances.webp';
import { whatsappUrl } from '@/lib/utils';
---

<section class="home-hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><span></span> Servicio técnico en Cali</p>
      <h1
        class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight text-balance"
      >
        Soluciones Confiables para Aire Acondicionado, Neveras, Lavadoras y Más
      </h1>
      <p class="text-lg text-white/90 mb-8 max-w-xl mx-auto lg:mx-0">
        En Rivera Refrigeración, somos expertos en brindar soluciones de calidad
        para todas tus necesidades de climatización y electrodomésticos. Con más
        de 30 años de experiencia en el sector, Ruben Dario Rivera se ha
        especializado en la instalación, mantenimiento y reparación de aire
        acondicionado, neveras, lavadoras y calentadores.
      </p>
      <a
        href={whatsappUrl('desde la portada')}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-lg hero-cta"
      >
        Agende su visita
      </a>
    </div>
    <div class="hero-visual">
      <div class="hero-orbit" aria-hidden="true"></div>
      <span class="visual-index" aria-hidden="true">R / 01</span>
      <Picture
        src={electrodomesticos}
        formats={['avif']}
        fallbackFormat="webp"
        alt="Aire acondicionado, nevera y lavadora - Servicios de Rivera Refrigeración"
        class="hero-appliances"
        width={480}
        height={480}
        widths={[320, 480, 800]}
        sizes="(min-width: 1024px) 440px, 280px"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-seal">
        <strong>30+</strong><span>Años de experiencia</span>
      </div>
      <span class="visual-caption">Hogares y negocios · Cali</span>
    </div>
  </div>
  <div class="hero-footer container" aria-label="Especialidades">
    <span>Aire acondicionado</span><span>Neveras</span><span>Lavadoras</span
    ><span>Calentadores</span>
  </div>
</section>
