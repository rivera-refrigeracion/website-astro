---
import { getImage } from 'astro:assets';
import electrodomesticos from '@/assets/images/hero-appliances.webp';
import { whatsappUrl } from '@/lib/utils';

// La ilustración sólo se ve desde lg (1024 px). Con <source media> el
// navegador ni la pide en móvil, donde el contenedor está oculto; el <img>
// de respaldo es un GIF vacío en línea que tampoco genera petición.
const ESCRITORIO = '(min-width: 1024px)';
const ANCHOS = [448, 800];
const [heroAvif, heroWebp] = await Promise.all(
  (['avif', 'webp'] as const).map((format) =>
    getImage({ src: electrodomesticos, format, widths: ANCHOS })
  )
);
const PIXEL_VACIO =
  'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

<section
  class="relative bg-gradient-to-br from-primary-700 via-primary-800 to-primary-900 text-white overflow-hidden"
>
  <div class="container relative py-16 lg:py-24">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div class="text-center lg:text-left">
        <h1
          class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight text-balance"
        >
          Soluciones Confiables para Aire Acondicionado, Neveras, Lavadoras y
          Más
        </h1>
        <p class="text-lg text-white/90 mb-8 max-w-xl mx-auto lg:mx-0">
          En Rivera Refrigeración, somos expertos en brindar soluciones de
          calidad para todas tus necesidades de climatización y
          electrodomésticos. Con más de 30 años de experiencia en el sector,
          Ruben Dario Rivera se ha especializado en la instalación,
          mantenimiento y reparación de aire acondicionado, neveras, lavadoras y
          calentadores.
        </p>
        <a
          href={whatsappUrl('desde la portada')}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-lg bg-secondary-500 hover:bg-secondary-600 text-neutral-900 font-semibold shadow-lg hover:shadow-xl transition-all"
        >
          Agenda tu cita
        </a>
      </div>

      <!-- Hero Image -->
      <div class="relative hidden lg:block">
        <div class="relative w-full aspect-square max-w-md mx-auto">
          <picture>
            <source
              media={ESCRITORIO}
              type="image/avif"
              srcset={heroAvif.srcSet.attribute}
              sizes="448px"
            />
            <source
              media={ESCRITORIO}
              type="image/webp"
              srcset={heroWebp.srcSet.attribute}
              sizes="448px"
            />
            <img
              src={PIXEL_VACIO}
              alt="Aire acondicionado, nevera y lavadora - Servicios de Rivera Refrigeración"
              class="w-full h-full object-contain drop-shadow-2xl"
              width="448"
              height="448"
              fetchpriority="high"
            />
          </picture>
        </div>
      </div>
    </div>
  </div>
</section>
