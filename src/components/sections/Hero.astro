---
import { CONTACT } from '@/lib/config';
---

<section
  class="relative bg-gradient-to-br from-primary-700 via-primary-800 to-primary-900 text-white overflow-hidden"
>
  <div class="container relative py-16 lg:py-24">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div class="text-center lg:text-left">
        <h1
          class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight text-balance"
        >
          Soluciones Confiables para Aire Acondicionado, Neveras, Lavadoras y
          Más
        </h1>
        <p class="text-lg text-white/90 mb-8 max-w-xl mx-auto lg:mx-0">
          En Rivera Refrigeración, somos expertos en brindar soluciones de
          calidad para todas tus necesidades de climatización y
          electrodomésticos. Con más de 30 años de experiencia en el sector,
          Ruben Dario Rivera se ha especializado en la instalación,
          mantenimiento y reparación de aire acondicionado, neveras, lavadoras y
          calentadores.
        </p>
        <a
          href={CONTACT.appointmentLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-lg bg-secondary-500 hover:bg-secondary-600 text-white font-semibold shadow-lg hover:shadow-xl transition-all"
        >
          Agenda tu cita
        </a>
      </div>

      <!-- Hero Image -->
      <div class="relative hidden lg:block">
        <div class="relative w-full aspect-square max-w-md mx-auto">
          <img
            src="/images/hero-appliances.webp"
            alt="Aire acondicionado, nevera y lavadora - Servicios de Rivera Refrigeración"
            class="w-full h-full object-contain drop-shadow-2xl"
            loading="eager"
            width="500"
            height="500"
          />
        </div>
      </div>
    </div>
  </div>
</section>
