---
import Turbine from '@/components/ui/Turbine.astro';
import Wave from '@/components/ui/Wave.astro';
import { whatsappUrl } from '@/lib/utils';
---

<section class="cierre on-dark relative isolate overflow-hidden py-24 lg:py-36">
  <Wave flip />
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="cierre-brillo respirar"></div>
    <Turbine
      class="cierre-turbina girar-inverso text-primary-300"
      tone="var(--color-primary-600)"
    />
  </div>
  <div class="container text-center" data-reveal>
    <h2 class="text-3xl lg:text-5xl font-bold mb-6 text-white">
      ¡Contrátanos!
    </h2>
    <p
      class="text-lg lg:text-xl text-primary-50/90 leading-relaxed mb-10 max-w-2xl mx-auto"
    >
      ¿Tienes problemas con tu aire acondicionado, nevera o lavadora? Nuestro
      equipo está listo para ayudarte.
    </p>
    <a
      href={whatsappUrl('desde el cierre de la portada')}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-lg btn-accent"
    >
      Agenda tu cita
    </a>
  </div>
</section>

<style>
  .cierre {
    background: linear-gradient(
      160deg,
      var(--color-primary-900),
      var(--color-primary-950) 70%
    );
  }

  .cierre-brillo {
    position: absolute;
    width: 60rem;
    height: 36rem;
    left: 50%;
    bottom: -24rem;
    margin-left: -30rem;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(255 122 26 / 0.32),
      rgb(255 122 26 / 0)
    );
  }

  :global(.cierre-turbina) {
    position: absolute;
    width: 36rem;
    height: 36rem;
    top: 50%;
    left: -14rem;
    margin-top: -18rem;
    opacity: 0.09;
    --giro: 100s;
  }
</style>
