---
import { whatsappUrl } from '@/lib/utils';
---

<section class="home-cta py-16 lg:py-24 text-white">
  <div class="container text-center">
    <h2 class="text-3xl lg:text-4xl font-bold mb-6">¡Contrátanos!</h2>
    <p class="text-lg text-white/90 mb-8 max-w-2xl mx-auto">
      ¿Tienes problemas con tu aire acondicionado, nevera o lavadora? Nuestro
      equipo está listo para ayudarte.
    </p>
    <a
      href={whatsappUrl('desde el cierre de la portada')}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-lg bg-secondary-500 hover:bg-secondary-600 text-neutral-900 font-semibold shadow-lg hover:shadow-xl transition-all"
    >
      Agende su visita
    </a>
  </div>
</section>
