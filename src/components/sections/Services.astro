---
import { Picture } from 'astro:assets';
import { SERVICES } from '@/lib/config';
import { imagenLocal } from '@/lib/images';

const serviceImages: Record<string, string> = {
  'aire-acondicionado': '/images/services/aire-acondicionado.jpg',
  neveras: '/images/services/nevera.webp',
  lavadoras: '/images/services/lavadora.webp',
  calentadores: '/images/services/calentadores.webp',
};
---

<section id="services" class="section bg-white">
  <div class="container">
    <h2 class="section-title">Nuestros servicios</h2>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 auto-rows-fr">
      {
        SERVICES.map((service, index) => (
          <a
            href={`/servicios/${service.id}/`}
            class="card service-card flex flex-col group"
            data-reveal
          >
            <span class="service-number" aria-hidden="true">
              0{index + 1}
            </span>
            <figure class="service-image">
              <Picture
                src={imagenLocal(
                  serviceImages[service.id] ||
                    '/images/services/aire-acondicionado.jpg'
                )}
                formats={['avif']}
                fallbackFormat="webp"
                alt={service.title}
                class="object-contain mx-auto"
                width={224}
                height={224}
                widths={[224, 448]}
                sizes="224px"
                loading="lazy"
              />
            </figure>
            <h3 class="text-xl font-semibold mb-3 text-neutral-900">
              {service.title}
            </h3>
            <p class="text-neutral-600 leading-relaxed mb-4 flex-grow">
              {service.description}
            </p>
            <span class="inline-flex items-center gap-1 text-secondary-950 font-medium text-sm mt-auto">
              Ver más
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
