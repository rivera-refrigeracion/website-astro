---
import { SERVICES } from '@/lib/config';

const serviceImages: Record<string, string> = {
  'aire-acondicionado': '/images/services/aire-acondicionado.jpg',
  neveras: '/images/services/nevera.webp',
  lavadoras: '/images/services/lavadora.webp',
  calentadores: '/images/services/calentador.png',
};
---

<section id="services" class="section bg-white">
  <div class="container">
    <h2 class="section-title">Nuestros servicios</h2>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {
        SERVICES.map((service) => (
          <article class="card text-center hover:shadow-[var(--shadow-level2)] transition-shadow">
            <figure class="mb-4">
              <img
                src={
                  serviceImages[service.id] ||
                  '/images/services/aire-acondicionado.jpg'
                }
                alt={service.title}
                class="w-32 h-32 object-contain mx-auto"
                loading="lazy"
                width="128"
                height="128"
              />
            </figure>
            <h3 class="text-xl font-semibold mb-3 text-neutral-900">
              {service.title}
            </h3>
            <p class="text-neutral-600 leading-relaxed">
              {service.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
