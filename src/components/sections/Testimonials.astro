---
import { TESTIMONIALS } from '@/lib/config';
---

<section id="reviews" class="section testimonios relative overflow-hidden">
  <div class="testimonios-comillas" aria-hidden="true">&ldquo;</div>
  <div class="container relative">
    <div class="max-w-3xl mx-auto text-center">
      {
        TESTIMONIALS.map((testimonial) => (
          <figure class="testimonio space-y-6" data-reveal="zoom">
            <div class="flex justify-center mb-4">
              <div class="testimonio-icono w-16 h-16 rounded-2xl flex items-center justify-center">
                <svg
                  class="w-7 h-7 text-white"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                </svg>
              </div>
            </div>
            <blockquote class="text-lg md:text-2xl text-neutral-800 font-heading font-medium leading-relaxed text-balance">
              {testimonial.text}
            </blockquote>
            <figcaption class="inline-flex items-center gap-3 font-semibold text-neutral-900">
              <span class="testimonio-raya" aria-hidden="true" />
              {testimonial.author}
              <span class="testimonio-raya" aria-hidden="true" />
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .testimonios {
    background:
      radial-gradient(
        40rem 24rem at 0% 100%,
        rgb(33 150 243 / 0.08),
        transparent 70%
      ),
      radial-gradient(
        40rem 24rem at 100% 0%,
        rgb(255 152 0 / 0.08),
        transparent 70%
      ),
      var(--color-neutral-100);
  }

  .testimonios-comillas {
    position: absolute;
    top: -2.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-heading);
    font-size: 22rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-primary-500);
    opacity: 0.06;
    pointer-events: none;
    user-select: none;
  }

  .testimonio {
    position: relative;
    padding: 2.5rem 1.5rem;
    border-radius: var(--radius-xl);
    background: white;
    box-shadow: var(--shadow-level2);
    border: 1px solid rgb(7 31 71 / 0.06);
  }

  @media (min-width: 768px) {
    .testimonio {
      padding: 3.5rem 4rem;
    }
  }

  .testimonio-icono {
    background: linear-gradient(
      135deg,
      var(--color-primary-600),
      var(--color-primary-900)
    );
    box-shadow: 0 10px 24px -8px rgb(21 101 192 / 0.6);
    transform: rotate(-6deg);
  }

  .testimonio-raya {
    display: block;
    width: 1.75rem;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(
      90deg,
      var(--color-primary-500),
      var(--color-primary-200)
    );
  }
</style>
