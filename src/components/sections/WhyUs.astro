---
import { WHY_US } from '@/lib/config';

const icons = {
  'shield-check': `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
  </svg>`,
  users: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 17.5l1.5 1.5 3-3" />
  </svg>`,
  clock: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
  </svg>`,
};
---

<section id="whyus" class="section bg-white">
  <div class="container">
    <h2 class="section-title">Por qué Elegirnos</h2>

    <div class="grid md:grid-cols-3 gap-8">
      {
        WHY_US.map((item) => (
          <article class="text-center">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-secondary-100 text-secondary-600 mb-6">
              <Fragment set:html={icons[item.icon as keyof typeof icons]} />
            </div>
            <h3 class="text-xl font-semibold mb-3 text-neutral-900">
              {item.title}
            </h3>
            <p class="text-neutral-600 leading-relaxed">{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
